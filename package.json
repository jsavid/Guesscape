{
  "name": "guesscape",
  "version": "1.2.0",
  "description": "Guesscape App",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "build:exe": "electron-packager . Guesscape --platform=win32 --arch=x64 --out=dist --icon=assets/icon.ico --overwrite --prune=true --ignore=android --ignore=fotos",
    "build:apk": "npm run cap:sync && cd android && gradlew assembleRelease",
    "build:aab": "npm run cap:sync && cd android && gradlew bundleRelease",
    "cap:sync": "node build.js && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "keywords": [
    "geo",
    "quiz",
    "capacitor",
    "android"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0",
    "electron-packager": "^17.1.2"
  }
}
